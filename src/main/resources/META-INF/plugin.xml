<idea-plugin>
    <id>io.github.tungnk123.material-theme-preview</id>
    <name>Material Theme Preview</name>
    <vendor url="https://github.com/tungnk123">tungnk123</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <description><![CDATA[
        Inline preview for MaterialTheme color / typography / shapes.
    ]]></description>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.inlayProviderFactory
                implementation="io.github.tungnk123.materialthemepreview.inlay.MaterialThemeInlayProviderFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <platform.backend.documentation.targetProvider
                implementation="io.github.tungnk123.materialthemepreview.doc.MaterialThemeDocTargetProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="io.github.tungnk123.materialthemepreview.gutter.MaterialThemeGutterProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor
                language="kotlin"
                order="first"
                implementationClass="io.github.tungnk123.materialthemepreview.complete.MaterialThemeCompletionContributor"/>
    </extensions>

</idea-plugin>
